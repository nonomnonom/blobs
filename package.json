{
  "name": "blobs",
  "version": "0.5.0",
  "private": true,
  "description": "Release orchestration for the Blobs Android app.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-android-version.mjs",
    "release:check": "node scripts/sync-android-version.mjs --check",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8"
  }
}
